<slide xmlns="https://www.larkoffice.com/sml/2.0">
  <style><fill><fillColor color="rgb(255,255,255)"/></fill></style>
  <data>
    <shape type="text" topLeftX="40" topLeftY="40" width="880" height="40">
      <content textType="body" fontSize="18"><p>A: <formula><latex><![CDATA[m_i=\sum_{j\in N(i)} g_{ij} W_{dir} h_j]]></latex></formula></p></content>
    </shape>
    <shape type="text" topLeftX="40" topLeftY="100" width="880" height="40">
      <content textType="body" fontSize="18"><p>B: <formula><latex><![CDATA[m_i=\sum_{j} g_{ij} W_{j\rightarrow i} h_j]]></latex></formula></p></content>
    </shape>
    <shape type="text" topLeftX="40" topLeftY="160" width="880" height="40">
      <content textType="body" fontSize="18"><p>C: <formula><latex><![CDATA[W_{\mathrm{dir}(j\to i)}]]></latex></formula></p></content>
    </shape>
    <shape type="text" topLeftX="40" topLeftY="220" width="880" height="40">
      <content textType="body" fontSize="18"><p>D: <formula><latex><![CDATA[m_i=\sum_{j\in N(i)} g_{ij}\,W_{\mathrm{dir}(j\to i)}\,h_j]]></latex></formula></p></content>
    </shape>
    <shape type="text" topLeftX="40" topLeftY="280" width="880" height="40">
      <content textType="body" fontSize="18"><p>E: <formula><latex><![CDATA[m_i=\sum_{j \sim i} g_{ij} W^{(j\to i)} h_j]]></latex></formula></p></content>
    </shape>
    <shape type="text" topLeftX="40" topLeftY="340" width="880" height="40">
      <content textType="body" fontSize="18"><p>F: <formula><latex><![CDATA[m_i=\bigoplus_{j\in N(i)} g_{ij} W_{j\to i} h_j]]></latex></formula></p></content>
    </shape>
    <shape type="text" topLeftX="40" topLeftY="400" width="880" height="40">
      <content textType="body" fontSize="18"><p>G: <formula><latex><![CDATA[m_i = \sum_{j \in \mathcal{N}(i)} g_{ij} W_{j \to i} h_j]]></latex></formula></p></content>
    </shape>
  </data>
