      <shape width="280" height="52" topLeftX="48" topLeftY="238" type="text" id="bXK">
        <content textType="headline" fontSize="42" fontFamily="思源宋体" color="rgba(94, 42, 42, 1)" bold="true" wrap="false">
          <p>≈ 570</p>
        </content>
      </shape>
      <shape width="286" height="40" topLeftX="48" topLeftY="294" type="text" id="bXC">
        <content fontSize="13" fontFamily="思源黑体" color="rgba(70, 64, 56, 1)" lineSpacing="multiple:1.35">
          <p>其中有连续观测记录、</p>
          <p>真正能用于建模的站点</p>
        </content>
      </shape>
      <line id="bXd" startX="48" startY="350" endX="330.0017730440715" endY="350">
        <border color="rgba(216, 209, 192, 1)" width="1" />
      </line>
      <shape width="280" height="52" topLeftX="48" topLeftY="364" type="text" id="bXt">
        <content textType="headline" fontSize="42" fontFamily="思源宋体" color="rgba(176, 122, 46, 1)" bold="true" wrap="false">
          <p>8.9%</p>
