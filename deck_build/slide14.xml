    <line startX="48" startY="508" endX="912" endY="508"><border color="rgb(201, 192, 172)" width="1"/></line>
    <shape type="text" topLeftX="48" topLeftY="514" width="520" height="16">
      <content textType="caption" fontSize="9" fontFamily="思源黑体" color="rgb(150, 143, 130)" wrap="false"><p>统计：experiments/analysis/headwater_recovery.csv（已复核）；审计：experiments/analysis/</p></content>
    </shape>
    <shape type="text" topLeftX="800" topLeftY="514" width="112" height="16">
      <content textType="caption" fontSize="9" fontFamily="思源黑体" color="rgb(150, 143, 130)" textAlign="right" wrap="false"><p>14 / 18</p></content>
