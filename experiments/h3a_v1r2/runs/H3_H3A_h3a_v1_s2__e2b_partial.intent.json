        "h3a": {
          "inputs": "env21+h2x",
          "family": "h3_residual",
          "base": "env",
          "correction": "h2x",
          "combination": "base_plus_correction",
          "scale": "log1p",
          "pretraining": false,
          "freeze_base": false,
          "auxiliary_loss": null,
          "learnable_fusion": false
        }
