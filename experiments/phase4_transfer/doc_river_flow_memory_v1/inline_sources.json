    {
      "id": "independent-flow-access",
      "title": "独立NEON水文响应复验尚待授权数据下载",
      "queries": [
        {
          "id": "neon-discharge-access",
          "source": {
            "label": "NEON连续流量官方数据接口",
            "links": [
              {
                "label": "官方流量产品说明",
                "url": "https://www.neonscience.org/resources/learning-hub/tutorials/continuous-discharge-intro"
              },
              {
                "label": "官方接口授权要求",
                "url": "https://data.neonscience.org/data-api/endpoints/data/"
              }
            ],
            "caveats": [
              "对官方BLUE/2024-06流量端点的一次无凭证请求返回403，未获取原始流量；独立DOC—流量复验尚未执行。"
            ],
            "evidenceFlow": [
              {
                "kind": "source",
                "title": "已确认数据来源",
                "detail": "DP4.00130.001是官方连续流量产品，下载端点要求已授权账户API token。"
              }
            ]
          }
        }
      ]
    }
