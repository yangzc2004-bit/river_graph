{
  "model_class": "DailyHydroRouter",
  "version": 1,
  "rule": "any_numeric_descriptor_valid_selects_daily_else_monthly",
  "daily_feature_names": [
    "daily_flow_width",
    "daily_flow_flashiness",
    "daily_flow_rising_fraction",
    "daily_flow_day_fraction",
    "daily_flow_pair_fraction",
    "daily_flow_width_valid",
    "daily_flow_flashiness_valid",
    "daily_flow_rising_valid"
  ],
  "validity_feature_indices": [
    5,
    6,
    7
  ],
  "input_space": "native prediction units",
  "stage": "base routing before ecological mixture and support adaptation",
  "fitted_parameters": false,
  "target_label_dependency": "none"
}
