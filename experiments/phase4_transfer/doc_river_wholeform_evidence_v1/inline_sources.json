    {
      "id": "independent-field-source",
      "title": "已取得可用于独立形态验证的实验室 DOC 资料",
      "queries": [
        {
          "id": "neon-lab-doc-coverage",
          "source": {
            "label": "NEON公开实验室DOC汇编",
            "files": [
              {
                "label": "absNEON_output.csv"
              },
              {
                "label": "absNEON_output_older_samples.csv"
              },
              {
                "label": "neon_profile_summary.json"
              }
            ],
            "links": [
              {
                "label": "公开数据集",
                "url": "https://zenodo.org/records/20039155"
              },
              {
                "label": "官方化学数据与传感器说明",
                "url": "https://www.neonscience.org/resources/learning-hub/tutorials/aquatic-data-product-integration"
              }
            ],
            "metricDefinitions": [
              {
                "label": "河流站点候选",
                "definition": "排除7个湖泊站点后的27个河流和溪流站点；尚未验证河网之间是否独立。"
              },
              {
                "label": "常规位置采样次数",
                "definition": "在相同基本样品编号内合并重复样品后的常规表层位置DOC采样次数。"
              }
            ],
            "filters": [
              "湖泊站点单列；迁移位置RE不进入常规位置统计。"
            ],
            "caveats": [
              "DOC来自吸光度加工所覆盖的原实验室样本子集，不是完整NEON化学数据总体。",
              "原质量标识、检出限、准确采样点、流量和完整河网几何尚未提供或核验。",
              "约14天一次的观测不能验证小时级事件峰值或河网传播。"
            ],
            "evidenceFlow": [
              {
                "kind": "validation",
                "title": "原始数据与采样单位检查",
                "detail": "两个公开文件与发布的大小及校验值一致；CSV独立计数确认27站点、4800次常规位置采样；重复均值的最大复核误差为8.9×10^-16。"
              }
            ]
          },
          "columns": [
            "river_sites",
            "raw_river_rows",
            "primary_surface_occasions",
            "median_interval_days"
          ],
          "rows": [
            {
              "river_sites": 27,
              "raw_river_rows": 5530,
              "primary_surface_occasions": 4800,
              "median_interval_days": 13.953472222222222
            }
          ]
        }
      ]
    }
