    {
      "id": "whole-form-doc-evidence",
      "title": "河网结构已有额外 DOC 信息，粗形态排序仍未确立",
      "queries": [
        {
          "id": "existing-form-comparisons",
          "source": {
            "label": "项目既有河网形态研究",
            "files": [
              {
                "label": "morphology_block_gains.csv"
              },
              {
                "label": "paired_doc_contrasts.csv"
              },
              {
                "label": "evidence_summary.csv"
              }
            ],
            "metricDefinitions": [
              {
                "label": "结构信息增益",
                "definition": "在相同环境和面积背景下，加入真实河网结构后对站点 DOC 中位数的相对 MAE 降幅。"
              },
              {
                "label": "形态对比",
                "definition": "匹配的宽阔多支流型减去长条多支流型的站点 DOC 中位数差。"
              }
            ],
            "caveats": [
              "结构信息增益来自297个源角色站点、62个HUC4的探索性诊断，不是月尺度重建模型提升或因果效应。",
              "直接形态比较包括22对非嵌套河网、12个HUC4；其区间包含零，尚不能确定形态排序。"
            ],
            "evidenceFlow": [
              {
                "kind": "validation",
                "title": "既有结果核对",
                "detail": "从冻结分析表抽取原估计与区间；没有重新拟合或重新选择形态指标。"
              }
            ]
          },
          "columns": [
            "finding",
            "estimate",
            "ci_low",
            "ci_high",
            "unit",
            "sample_count",
            "group_count"
          ],
          "rows": [
            {
              "finding": "footprint_predictive_information",
              "estimate": 1.8701976745889184,
              "ci_low": -0.5218902702959104,
              "ci_high": 4.629284512834429,
              "unit": "relative MAE reduction percent",
              "sample_count": 297,
              "group_count": 62
            },
            {
