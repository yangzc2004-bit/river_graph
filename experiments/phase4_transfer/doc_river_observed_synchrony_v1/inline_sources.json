    {
      "id": "within-river-periods",
      "title": "Repeated periods provide limited within-river evidence",
      "queries": [
        {
          "id": "repeated-periods",
          "source": {
            "label": "Fixed five-year periods",
            "files": [
              {
                "label": "within_network_association.csv"
              },
              {
                "label": "within_network_periods.csv"
              },
              {
                "label": "period_inventory.csv"
              }
            ],
            "metricDefinitions": [
              {
                "label": "Within-river association",
                "definition": "The association relates receiver-centered source coordination to receiver-centered log receiving-relative SD, giving each repeated river equal total weight."
              }
            ],
            "filters": [
              "Non-overlapping calendar five-year blocks",
              "At least 24 dates, three sampled years and six calendar months per block",
              "At least two eligible periods per receiving network"
            ],
            "caveats": [
              "Only four receiving networks have repeated eligible periods, totaling 11 periods in three overlapping systems.",
              "The interval includes zero; this comparison does not establish an input-timing mediation effect."
            ]
          },
          "columns": [
            "n_receivers",
            "n_periods",
            "n_components",
            "correlation",
            "ci_low",
            "ci_high"
          ],
          "rows": [
            {
              "n_receivers": 4,
              "n_periods": 11,
              "n_components": 3,
              "correlation": 0.192952915,
              "ci_low": -0.5136954561,
              "ci_high": 1.0
            }
          ],
          "preview": {
            "kind": "aggregate",
            "note": "Reviewed observational measures for the displayed population."
          }
        }
      ]
    }
