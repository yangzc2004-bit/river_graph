    {
      "id": "receiving-reference",
      "title": "Observed source coordination and receiving fluctuation",
      "queries": [
        {
          "id": "network-response",
          "source": {
            "label": "Common-date river DOC",
            "files": [
              {
                "label": "network_metrics.csv"
              },
              {
                "label": "observed_series.parquet"
              }
            ],
            "metricDefinitions": [
              {
                "label": "Source coordination",
                "definition": "Source coordination is the source-variance-weighted mean pair correlation on identical sampled months."
              },
              {
                "label": "Receiving SD reference",
                "definition": "Receiving relative SD divides the observed receiving SD by the sum of area-share-weighted individual source SDs, without source pair covariance."
              }
            ],
            "filters": [
              "Original geometric-mainstem source frontiers",
              "Common-calendar native DOC observations",
              "Seasonal sine/cosine and linear-year adjustment",
              "All 32 unique receiving networks"
            ],
            "caveats": [
              "The 32 receiving networks belong to seven overlapping-catchment systems, not 32 independent basins.",
              "Source shares use represented catchment area, not synchronized flow or DOC load.",
              "The receiving-coordination correlation is descriptive and does not establish transit time or causality."
            ]
          },
          "columns": [
            "target",
            "form",
            "covered_area_fraction",
            "n_dates",
            "source_coherence",
            "receiver_relative_sd"
          ],
