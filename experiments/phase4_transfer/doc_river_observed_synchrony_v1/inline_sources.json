    {
      "id": "coincident-excursions",
      "title": "Joint tributary highs correspond to more receiving highs",
      "queries": [
        {
          "id": "excursion-contrast",
          "source": {
            "label": "Receiving-excursion contrast",
            "files": [
              {
                "label": "signal_summary.csv"
              },
              {
                "label": "network_metrics.csv"
              }
            ],
            "metricDefinitions": [
              {
                "label": "Excursion difference",
                "definition": "The receiving-excursion difference is the receiver-equal average probability with at least two source excursions minus that with exactly one source excursion; intervals resample complete catchment systems 5,000 times."
              }
            ],
            "filters": [
              "Each source and receiver exceeds its own 75th anomaly percentile",
              "Both source-condition groups have at least five dates",
              "Fixed monitored source identities"
            ],
            "caveats": [
              "The primary estimate uses 17 eligible receiving networks in six systems; other networks remain in the amplitude panels.",
              "Same-calendar-day observations do not imply identical sampling instants.",
              "The retrospective excursion comparison is concurrent association, not a causal source effect."
            ]
          },
          "columns": [
            "population",
            "estimate_pp",
            "ci_low_pp",
            "ci_high_pp",
            "n_receivers",
            "n_components"
          ],
          "rows": [
            {
              "population": "All monthly networks",
              "estimate_pp": 19.616766338,
              "ci_low_pp": 10.7253932699,
              "ci_high_pp": 40.5753968254,
              "n_receivers": 17,
              "n_components": 6
            },
            {
              "population": "Area coverage >=80%",
              "estimate_pp": 27.2874034949,
              "ci_low_pp": 11.5501165501,
              "ci_high_pp": 45.8333333333,
              "n_receivers": 6,
              "n_components": 5
            },
            {
              "population": "Strict same-day activities",
              "estimate_pp": 17.0253357753,
              "ci_low_pp": 1.0416666667,
              "ci_high_pp": 28.6057692308,
              "n_receivers": 3,
              "n_components": 3
            }
          ],
          "preview": {
            "kind": "aggregate",
            "note": "Reviewed observational measures for the displayed population."
          }
        },
        {
          "id": "condition-probabilities",
          "source": {
            "label": "Receiver-equal conditional frequencies",
            "files": [
              {
                "label": "network_metrics.csv"
              }
            ],
            "metricDefinitions": [
              {
                "label": "Conditional frequency",
                "definition": "Each receiving network contributes equally to the mean receiving-excursion frequency under each observed upstream condition."
              }
            ],
            "filters": [
              "17 eligible monthly networks",
              "Calendar-adjusted upper-quartile excursions"
            ],
            "caveats": [
              "The reported mean probabilities are not pooled date proportions; the date counts show the retained denominators."
            ]
          },
          "columns": [
            "group",
            "mean_probability",
            "n_receivers",
            "n_dates"
          ],
          "rows": [
            {
              "group": "Coincident upstream excursions",
              "mean_probability": 0.4442725575,
              "n_receivers": 17,
              "n_dates": 194
            },
            {
              "group": "Exactly one upstream excursion",
              "mean_probability": 0.2481048941,
              "n_receivers": 17,
              "n_dates": 261
            }
          ],
          "preview": {
            "kind": "aggregate",
            "note": "Reviewed observational measures for the displayed population."
          }
        }
      ]
    },
    {
      "id": "whole-form-input-coordination",
      "title": "Broad and elongated forms do not establish different input coordination",
      "queries": [
        {
          "id": "coordination-by-form",
          "source": {
            "label": "Original whole-network form contrast",
            "files": [
              {
                "label": "form_contrasts.csv"
              },
              {
                "label": "network_metrics.csv"
              }
            ],
            "metricDefinitions": [
              {
                "label": "Form contrast",
                "definition": "The coordination contrast is the receiver-mean source coordination in broad networks minus that in elongated networks."
              }
            ],
            "filters": [
              "Original geometry-only whole-network classes",
              "All-receiver and >=80% represented-area subsets",
              "5,000 complete-system bootstrap draws"
            ],
            "caveats": [
              "Both coordination-contrast intervals include zero.",
              "Form and regional context remain confounded in the observed field populations."
            ]
          },
          "columns": [
            "minimum_coverage",
            "estimate",
            "ci_low",
            "ci_high",
            "n_broad",
            "n_elongated",
            "n_components"
          ],
